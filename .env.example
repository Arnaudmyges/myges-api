# Copier vers .env (jamais commité). Lu par `MyGES.from_env()` et la CLI.

# Identifiant myGES (même que sur l'appli / le site).
MYGES_USERNAME=jdupont
# Mot de passe. Facultatif si un token valide est déjà en cache (`myges login`),
# mais nécessaire pour le renouveler automatiquement après ~6 jours.
MYGES_PASSWORD=
# Alternative aux identifiants : token brut (ex. pour un usage ponctuel).
MYGES_TOKEN=

# Fuseau horaire d'affichage de la CLI (défaut : Europe/Paris, celui des campus).
MYGES_TZ=

# Désactive le rappel « nouvelle version disponible » (vérifié une fois par jour sur PyPI).
MYGES_NO_UPDATE_CHECK=
